---
const titolo = 'Sito di prova';
---
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
  </head>
  <body>
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__inner">
        <p class="hero__eyebrow">Daytwo · prova</p>
        <h1 class="hero__title">{titolo}</h1>
        <p class="hero__lead">Una pagina sola, per provare Daytwo.</p>
        <a class="hero__cta" href="mailto:hello@example.com">
          Scrivici
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
    color: #000;
    background: #fff;
  }

  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 4rem 1rem;
    box-sizing: border-box;
  }

  .hero__glow {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(40% 40% at 30% 35%, rgba(0, 0, 238, 0.28), transparent 70%),
      radial-gradient(35% 35% at 70% 65%, rgba(0, 0, 238, 0.16), transparent 70%);
    filter: blur(40px);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .hero__inner {
    position: relative;
    max-width: 640px;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 1.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid rgba(0, 0, 238, 0.25);
    border-radius: 999px;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: #0000ee;
    background: rgba(255, 255, 255, 0.7);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(3rem, 12vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero__lead {
    margin: 1.5rem auto 2.5rem;
    max-width: 32ch;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.7);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    background: #0000ee;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero__cta span {
    transition: transform 0.2s ease;
  }

  .hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 238, 0.35);
  }

  .hero__cta:hover span {
    transform: translateX(4px);
  }

  .hero__cta:focus-visible {
    outline: 3px solid #000;
    outline-offset: 3px;
  }

  @keyframes drift {
    from { transform: translate(-3%, -2%) scale(1); }
    to { transform: translate(3%, 2%) scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow { animation: none; }
    .hero__cta, .hero__cta span { transition: none; }
  }
</style>
