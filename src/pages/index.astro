---
const titolo = 'Sito di prova';
const parole = titolo.split(' ');
let indice = 0;
---
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
  </head>
  <body>
    <section class="hero">
      <div class="hero__glow" aria-hidden="true">
        <span class="hero__blob hero__blob--a"></span>
        <span class="hero__blob hero__blob--b"></span>
        <span class="hero__blob hero__blob--c"></span>
      </div>
      <div class="hero__inner">
        <p class="hero__eyebrow">Daytwo · prova</p>
        <h1 class="hero__title" aria-label={titolo}>
          {parole.map((parola, p) => (
            <>
              <span class="hero__word" aria-hidden="true">
                {parola.split('').map((lettera) => (
                  <span class="hero__letter" style={`--i: ${indice++}`}>{lettera}</span>
                ))}
              </span>
              {p < parole.length - 1 && ' '}
            </>
          ))}
        </h1>
        <p class="hero__lead">Una pagina sola, per provare Daytwo.</p>
        <a class="hero__cta" href="mailto:hello@example.com">
          Scrivici
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, sans-serif;
    color: #000;
    background: #fff;
  }

  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 4rem 1rem;
    box-sizing: border-box;
  }

  .hero__glow {
    position: absolute;
    inset: -20%;
    filter: blur(50px);
    transform: translate(var(--mx, 0px), var(--my, 0px));
    transition: transform 0.6s ease-out;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 0, 238, 0.32), transparent 70%);
  }

  .hero__blob--a {
    width: 45%;
    aspect-ratio: 1;
    top: 20%;
    left: 15%;
    animation: orbit-a 14s ease-in-out infinite alternate;
  }

  .hero__blob--b {
    width: 38%;
    aspect-ratio: 1;
    top: 40%;
    left: 50%;
    opacity: 0.7;
    animation: orbit-b 11s ease-in-out infinite alternate;
  }

  .hero__blob--c {
    width: 28%;
    aspect-ratio: 1;
    top: 10%;
    left: 60%;
    opacity: 0.5;
    animation: orbit-c 9s ease-in-out infinite alternate;
  }

  .hero__word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero__letter {
    display: inline-block;
    animation: letter-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 45ms);
    transition: transform 0.25s ease-out, color 0.25s ease-out;
  }

  .hero__letter:hover {
    transform: translateY(-0.08em) rotate(-4deg);
    color: #0000ee;
  }

  .hero__eyebrow,
  .hero__lead,
  .hero__cta {
    animation: fade-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
  }

  .hero__eyebrow { animation-delay: 0.1s; }
  .hero__lead { animation-delay: 0.55s; }
  .hero__cta { animation-delay: 0.7s; }

  .hero__inner {
    position: relative;
    max-width: 640px;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 1.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid rgba(0, 0, 238, 0.25);
    border-radius: 999px;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: #0000ee;
    background: rgba(255, 255, 255, 0.7);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(3rem, 12vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero__lead {
    margin: 1.5rem auto 2.5rem;
    max-width: 32ch;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.7);
  }

  .hero__cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    background: #0000ee;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero__cta span {
    transition: transform 0.2s ease;
  }

  .hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 238, 0.35);
  }

  .hero__cta:hover span {
    transform: translateX(4px);
  }

  .hero__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.45) 50%, transparent 70%);
    transform: translateX(-120%);
  }

  .hero__cta:hover::after {
    transform: translateX(120%);
    transition: transform 0.6s ease-out;
  }

  .hero__cta:focus-visible {
    outline: 3px solid #000;
    outline-offset: 3px;
  }

  @keyframes orbit-a {
    from { transform: translate(-10%, -5%) scale(1); }
    to { transform: translate(15%, 10%) scale(1.15); }
  }

  @keyframes orbit-b {
    from { transform: translate(10%, 5%) scale(1.1); }
    to { transform: translate(-20%, -10%) scale(0.9); }
  }

  @keyframes orbit-c {
    from { transform: translate(0, 0) scale(0.9); }
    to { transform: translate(-25%, 30%) scale(1.2); }
  }

  @keyframes letter-in {
    from { transform: translateY(0.35em) rotate(6deg); }
    to { transform: none; }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow,
    .hero__blob,
    .hero__letter,
    .hero__eyebrow,
    .hero__lead,
    .hero__cta,
    .hero__cta span,
    .hero__cta::after {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const glow = document.querySelector<HTMLElement>('.hero__glow');
  const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && glow && !ridotto && window.matchMedia('(hover: hover)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      glow.style.setProperty('--mx', `${x * 60}px`);
      glow.style.setProperty('--my', `${y * 60}px`);
    });
  }
</script>
